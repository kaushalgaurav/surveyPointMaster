def home():
    return {"status": "Combined API (Questions & Word) running"}


# --- Authentication Configuration ---
# .env file mein AUTH_SECRET_KEY hona chahiye
AUTH_KEY = os.getenv("API_AUTH_KEY")
api_key_header = APIKeyHeader(name="X-Auth-Key", auto_error=False)

async def validate_api_key(api_key: str = Security(api_key_header)):
    if not api_key or api_key != AUTH_KEY:
        raise HTTPException(
            status_code=403, 
            detail="Unauthorized: Invalid or missing Auth Key"
        )
    logger.info("API key validated successfully.")
    return api_key

@app.get("/health")
async def health_check():
    return {"status": "healthy"}

# --- Main Analysis Endpoint ---
@app.get("/api/v1/charts/{survey_url}")
async def get_survey_insights(
    survey_url: str, 
    auth: str = Depends(validate_api_key)
):
    try:
        # 1. Database se data fetch karein (Dynamic Logic)
        raw_data = database_chart.fetch_survey_data(survey_url)
        
        # Check: Agar database.py None return karta hai (Survey not found)
        if not raw_data:
            raise HTTPException(
                status_code=404, 
                detail=f"Survey with link '{survey_url}' not found in database."
            )

        # 2. Numeric ID validationv
        numeric_id = raw_data.get('numeric_id')
        if not numeric_id:
            raise HTTPException(
                status_code=400, 
                detail="Critical Error: Numeric ID could not be retrieved for this survey."
            )

        # 3. AI Analysis Process
        ai_analysis = process.analyze_with_ai(raw_data, numeric_id, survey_url)

        return ai_analysis

    except HTTPException as he:
        # FastAPI related errors (403, 404, 400) ko directly throw karein
        raise he
    except Exception as e:
        # Background logs ke liye error print karein
        print(f"Server Side Error: {str(e)}")
        raise HTTPException(
            status_code=500, 
            detail="Internal Server Error: Something went wrong during analysis."
        )