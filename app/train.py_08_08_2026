def map_to_defined_qtype(raw_qtype: str):
    if not raw_qtype: return "stextbox"
    qtype_lower = raw_qtype.strip().lower()
    for key, mapped_types in PROMPT_QTYPE_MAP.items():
        if key in qtype_lower: return mapped_types[0]
    return normalize_qtype.get(qtype_lower, "stextbox")

def detect_qtype_from_options(options):
    if not options: return None
    if len(options) == 2: return "radio"
    elif 3 <= len(options) <= 6: return "mcq"
    else: return "dropdown"

def format_ans_json_data(options, language="english"):
    if not options: return {}
    return {
        language: {
            "answer": [f"{i+1}|{opt}" for i, opt in enumerate(options)]
        }
    }

def normalize_openai_question(q: dict):
    question_text = q.get("question", "").strip()
    raw_qtype = q.get("qtype", "")
    raw_ans = q.get("ans_json_data", {})

    options = []
    if isinstance(raw_ans, dict):
        options = raw_ans.get("options", [])
    elif isinstance(raw_ans, list):
        options = raw_ans

    detected_qtype = detect_qtype_from_options(options)
    final_qtype = detected_qtype if detected_qtype else map_to_defined_qtype(raw_qtype)

    return {
        "question": question_text,
        "qtype": final_qtype,
        "ans_json_data": format_ans_json_data(options)
    }

def fetch_questions_openai(sector, description, n, template_title="", template_desc="", language="English"):
    if not openai.api_key: return []

    prompt = f"""
    You are an expert survey question generator.
    Sector: {sector}
    User Description: {description}
    Context: {template_title} - {template_desc}
    Language: {language}

    Rules:
    - Generate EXACTLY {n} questions.
    - Output strictly valid JSON list.
    - Fields: "question", "qtype", "options" (list of strings).
    - If Language is not English, translate questions/options accordingly.
    """

    try:
        response = openai.ChatCompletion.create(
            model="gpt-3.5-turbo",
            messages=[
                {"role": "system", "content": "You generate structured survey questions in JSON."},
                {"role": "user", "content": prompt}
            ],
            temperature=0.7
        )
        content = response.choices[0].message.content
        data = json.loads(content)
        return [normalize_openai_question(q) for q in data]
    except Exception as e:
        logger.error(f"OpenAI generation failed: {e}")
        return []

