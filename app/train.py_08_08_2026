def build_response(section_code: str, questions, languages=None):
    data = []

    if not languages:
        languages = ["english"]

    for q in questions:
        # --------------------
        # 1. Question language object
        # --------------------
        question_obj = {}

        if isinstance(q.get("question"), dict):
            # GPT already returned multi-language
            for lang in languages:
                if lang in q["question"]:
                    question_obj[lang] = q["question"][lang]
        else:
            # Single question → copy into all languages
            for lang in languages:
                question_obj[lang] = q["question"]

        # --------------------
        # 2. Answer JSON safety
        # --------------------
        ans_data = q.get("ans_json_data")

        if not ans_data or not isinstance(ans_data, dict):
            ans_data = None

        payload = {
            "question": question_obj,   # ✅ FIXED
            "qtype": q["qtype"],
            "ans_json_data": ans_data
        }

        data.append(payload)

    return {
        "Section": section_code,
        "Data": data
    }

