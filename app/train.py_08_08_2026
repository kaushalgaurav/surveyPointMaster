def clean_text(text: str) -> str:
    if not text:
        return ""
    text = re.sub(r'(\w)\s{2,}(\w)', r'\1\2', text)
    text = re.sub(r'\s+', ' ', text)
    return text.strip()

def clean_ans_json(ans_json):
    if not ans_json:
        return ans_json
    for lang, data in ans_json.items():
        if "answer" in data:
            data["answer"] = [clean_text(a) for a in data["answer"]]
    return ans_json

def compute_dataset_hash(data_list, keys):
    hasher = hashlib.md5()
    for item in data_list:
        key_str = "|".join([str(item.get(k, "")) for k in keys])
        hasher.update(key_str.encode("utf-8"))
    return hasher.hexdigest()

