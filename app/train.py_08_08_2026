def deduplicate_questions(questions, similarity_threshold: float = 0.85):
    final_questions = []
    used_qids = set()
    used_texts = set()
    used_embeddings = []

    for q in questions:
        qid = q.get("qid")
        text = " ".join(q.get("question", "").lower().split())
        emb = q.get("embedding")
        if emb is None: continue

        if qid in used_qids: continue
        if text in used_texts: continue

        is_duplicate = False
        if len(used_embeddings) > 0:
            used_emb_tensor = torch.stack(used_embeddings)
            sim_scores = util.cos_sim(emb, used_emb_tensor)
            if torch.max(sim_scores) >= similarity_threshold:
                is_duplicate = True
        
        if is_duplicate: continue

        final_questions.append(q)
        used_qids.add(qid)
        used_texts.add(text)
        used_embeddings.append(emb)

    return final_questions

def select_best_template(sector: str, description: str):
    if len(template_list) == 0: return None

    candidates = [
        (i, t) for i, t in enumerate(template_list)
        if t["sector"].lower() == sector.lower()
    ]
    if not candidates: return None

    query = f"{sector} {description}"
    query_emb = embed_model.encode(query, convert_to_tensor=True)

    scored = []
    for i, tpl in candidates:
        # Safety check for index
        if i < len(template_embeddings):
            score = util.cos_sim(query_emb, template_embeddings[i]).item()
            scored.append((tpl, score))

    scored.sort(key=lambda x: x[1], reverse=True)
    if not scored: return None

    best_tpl, score = scored[0]
    if score < 0.25: return None

    logger.info(f"Template selected | sector={sector} | title={best_tpl['template_title']} | score={score:.2f}")
    return best_tpl

def get_questions(sector: str, description: str, n: int, reference=None):
    reference = reference or []
    best_template = select_best_template(sector, description)
    template_id = best_template["template_id"] if best_template else None

    # Search
    query = f"{sector} {description} {' '.join(reference)}"
    query_embedding = embed_model.encode(query, convert_to_tensor=True)
    scores = util.cos_sim(query_embedding, question_embeddings)[0]

    candidates = []
    for i, q in enumerate(questions_list):
        if q["sector"].lower() != sector.lower(): continue
        # Soft filter: prioritize template if found
        if template_id and q["template_id"] != template_id: continue

        q_copy = q.copy()
        q_copy["embedding"] = question_embeddings[i]
        candidates.append((scores[i].item(), q_copy))

    candidates.sort(key=lambda x: x[0], reverse=True)
    raw_questions = [q for _, q in candidates]
    
    unique_questions = deduplicate_questions(raw_questions, similarity_threshold=0.85)
    top_questions = unique_questions[:n]

    # Optional: OpenAI Fallback logic here if needed

    return top_questions[:n]

