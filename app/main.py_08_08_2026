            # .dta file read karne ke liye pyreadstat ka read_dta use karein
            df, meta = pyreadstat.read_dta(file_path)
        else:
            raise HTTPException(status_code=400, detail="Unsupported file format. Only .sav and .dta are allowed.")

        # Metadata extraction (Stata aur SPSS dono ke liye pyreadstat same keys deta hai)
        value_mappings = meta.variable_value_labels
        variable_labels = meta.column_names_to_labels

        # --- PART 1: QUESTIONS SCHEMA ---
        # --- PART 1: QUESTIONS SCHEMA (TEXT FALLBACK LOGIC) ---
        questions_data = []
