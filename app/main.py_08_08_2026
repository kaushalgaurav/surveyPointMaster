class FilePath(BaseModel):
    path: str

def clean_raw_value(v):
    if pd.isna(v):
        return None
    if isinstance(v, (datetime, date, pd.Timestamp)):
        return v.isoformat()
    if isinstance(v, (np.float64, np.float32, float)):
        if v.is_integer():
            return str(int(v))
        return str(v)
    if isinstance(v, (np.int64, np.int32, int)):
        return str(int(v))
    return str(v).strip()

def get_qtype(var_name, value_mappings):
    if re.search(r'_\d+$', var_name):
        return "mcq"
    if var_name in value_mappings and value_mappings[var_name]:
        return "radio"
    return "stextbox"

@app.post("/process-sav")
async def process_sav(file_input: FilePath, x_api_key: str = Header(...)):
    # --- AUTHENTICATION INSIDE FUNCTION ---
    valid_key = os.getenv("API_AUTH_KEY") 
    if x_api_key != valid_key:
        print(f"Auth Failed: Received {x_api_key}, Expected {valid_key}")
        raise HTTPException(status_code=401, detail="Invalid Authentication Key")

    try:
        # 1. Load SAV File
        df, meta = pyreadstat.read_sav(file_input.path)
        value_mappings = meta.variable_value_labels
        variable_labels = meta.column_names_to_labels

        # --- PART 1: QUESTIONS SCHEMA (FINAL GROUPING LOGIC) ---
        # --- PART 1: QUESTIONS SCHEMA (TEXT FALLBACK LOGIC) ---
        questions_data = []
        processed_qids = set()

        for col in df.columns:
            # 1. Base ID extraction
            base_qid = re.sub(r'(_\d+|_oth)$', '', col)
            
            if base_qid in processed_qids: 
                continue
            
            # 2. MCQ Check: Suffix columns dhundna (_1, _2...)
            sub_cols = [c for c in df.columns if re.match(rf"^{base_qid}_\d+$", c)]
            
            # 3. Options/Answers ki talash
            answers_list = []
            mapping = {}

            # Pehle check karo kya ye MCQ lag raha hai?
            if sub_cols:
                # MCQ ke liye kisi bhi ek sub-column ki mapping uthao
                for sc in sub_cols:
                    m = value_mappings.get(sc)
                    if m:
                        mapping = m
                        break
            else:
                # Agar MCQ nahi hai, toh main column ki mapping check karo (Radio ke liye)
                mapping = value_mappings.get(col, {})

            # 4. Mapping se options list bharna
            if mapping and isinstance(mapping, dict):
                for val, label in mapping.items():
                    try:
                        clean_val = str(int(float(val))) if float(val).is_integer() else str(val)
                        # Label ko saaf karna
                        safe_label = str(label).strip() if label is not None else f"Option {val}"
                        answers_list.append(f"{clean_val}|{safe_label}")
                    except:
                        answers_list.append(f"{val}|{str(label).strip()}")

            # 5. --- FINAL TYPE DECISION (IMPORTANT) ---
            # Agar answers_list mil gayi hai:
            if answers_list:
                qtype = "mcq" if sub_cols else "radio"
                final_ans_json = {"english": {"answer": answers_list}}
            else:
                # AGAR OPTIONS NAHI HAIN -> SEEDHA TEXT BOX
                qtype = "stextbox"
                final_ans_json = None

